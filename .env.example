# =============================================================================
# EventEase Environment Configuration Template
# Copy this file to .env or configure your environment variables accordingly.
# =============================================================================

# Database Configuration (MySQL 8.x)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=eventease_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Backend Application Port
SERVER_PORT=8080

# Notification Service URL
NOTIFICATION_SERVICE_URL=http://localhost:8082

# Notification Service Port
NOTIFICATION_SERVICE_PORT=8082

# Frontend Application Configuration
VITE_API_BASE_URL=http://localhost:8080/api

# JWT / Security Secret (Min 256-bit secret for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
